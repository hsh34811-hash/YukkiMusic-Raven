# ==============================================================================
# 🎵 YukkiMusic - Raven Edition (2026 Go Engine)
# ==============================================================================
# Environment Configuration Template / نموذج متغيرات البيئة
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔴 REQUIRED VARIABLES / المتغيرات الأساسية المطلوبة
# ------------------------------------------------------------------------------
# Telegram API ID & Hash (Get from https://my.telegram.org)
API_ID=
API_HASH=

# Telegram Bot Token (Get from @BotFather)
TOKEN=

# MongoDB Atlas Connection URI (Get from https://www.mongodb.com)
MONGO_DB_URI=

# Pyrogram String Session for the Assistant Userbot (Generate via @SessionBuilderbot or genstring)
STRING_SESSIONS=
SESSION_TYPE=pyrogram

# ------------------------------------------------------------------------------
# 🟡 OWNER & ADMIN CONFIGURATION / إعدادات المالك والسودو
# ------------------------------------------------------------------------------
# Your Telegram User ID (Get from @userinfobot)
OWNER_ID=

# Logger Group/Channel ID (Must start with -100)
LOGGER_ID=

# ------------------------------------------------------------------------------
# 🔄 AUTONOMOUS UPDATER & REPOSITORY / إعدادات التحديث التلقائي
# ------------------------------------------------------------------------------
UPSTREAM_REPO=https://github.com/hsh34811-hash/YukkiMusic-RavenEdition.git
UPSTREAM_BRANCH=main

# ------------------------------------------------------------------------------
# 🍪 YOUTUBE ANTI-BLOCK / حل حظر يوتيوب عبر الكوكيز
# ------------------------------------------------------------------------------
# Export Netscape cookies from browser, paste into https://batbin.me, and paste the link here
COOKIES_LINK=

# Fallback API (Optional)
FALLEN_API_KEY=
FALLEN_API_URL=https://beta.fallenapi.fun

# ------------------------------------------------------------------------------
# 🎧 SPOTIFY CREDENTIALS (OPTIONAL) / بيانات سبوتيفاي الاختيارية
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# ⚙️ CUSTOMIZATION & LIMITS / التخصيص والحدود
# ------------------------------------------------------------------------------
DEFAULT_LANG=ar
DURATION_LIMIT=5400
QUEUE_LIMIT=30
MAX_AUTH_USERS=25
LEAVE_ON_DEMOTED=false
SET_CMDS=true

# Branding & Support Links
SUPPORT_CHAT=https://t.me/Raven_xx24
SUPPORT_CHANNEL=https://t.me/Raven_xx24

# Images & Assets
PING_IMG_URL=https://telegra.ph/file/91533956c91d0fd7c9f20.jpg
START_IMAGES=
DISABLE_COLOUR=false
ENABLE_PPROF=false